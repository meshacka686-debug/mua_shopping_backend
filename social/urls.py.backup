from django.urls import path

from .views import (
    FollowersView,
    FollowingView,
    MyLikedPostsView,
    SocialPostCreateView,
    SocialPostDeleteView,
    SocialPostLikeView,
    SocialPostLikesView,
    SocialPostListView,
    SocialPostCommentsView,
    SocialPostCommentCreateView,
    SocialPostCommentDeleteView,
    UserFollowToggleView,
    UserProfileView,
)


urlpatterns = [
    path(
        "posts/",
        SocialPostListView.as_view(),
        name="social-posts",
    ),
    path(
        "liked-posts/",
        MyLikedPostsView.as_view(),
        name="social-liked-posts",
    ),
    path(
        "posts/create/",
        SocialPostCreateView.as_view(),
        name="social-post-create",
    ),
    path(
        "posts/<int:pk>/",
        SocialPostDeleteView.as_view(),
        name="social-post-delete",
    ),
    path(
        "posts/<int:pk>/like/",
        SocialPostLikeView.as_view(),
        name="social-post-like",
    ),
    path(
        "posts/<int:pk>/likes/",
        SocialPostLikesView.as_view(),
        name="social-post-likes",
    ),
    path(
        "posts/<int:pk>/comments/",
        SocialPostCommentsView.as_view(),
        name="social-post-comments",
    ),
    path(
        "posts/<int:pk>/comments/create/",
        SocialPostCommentCreateView.as_view(),
        name="social-post-comment-create",
    ),
    path(
        "comments/<int:pk>/",
        SocialPostCommentDeleteView.as_view(),
        name="social-post-comment-delete",
    ),
    path(
        "profile/",
        UserProfileView.as_view(),
        name="social-my-profile",
    ),
    path(
        "profile/<str:username>/",
        UserProfileView.as_view(),
        name="social-user-profile",
    ),
    path(
        "profile/<str:username>/followers/",
        FollowersView.as_view(),
        name="social-followers",
    ),
    path(
        "profile/<str:username>/following/",
        FollowingView.as_view(),
        name="social-following",
    ),
    path(
        "follow/<str:username>/",
        UserFollowToggleView.as_view(),
        name="social-follow-toggle",
    ),
]
