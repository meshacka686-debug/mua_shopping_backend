from rest_framework import serializers

from .models import Rent, RentBooking


class RentSerializer(serializers.ModelSerializer):
    owner_id = serializers.IntegerField(
        source="owner.id",
        read_only=True,
    )

    owner_name = serializers.CharField(
        source="owner.username",
        read_only=True,
    )

    class Meta:
        model = Rent
        fields = [
            "id",
            "owner_id",
            "owner_name",
            "title",
            "description",
            "location",
            "price",
            "price_period",
            "image",
            "video",
            "is_available",
            "created_at",
            "updated_at",
        ]
        read_only_fields = [
            "id",
            "owner_id",
            "owner_name",
            "created_at",
            "updated_at",
        ]

    def to_representation(self, instance):
        data = super().to_representation(instance)

        request = self.context.get("request")

        for field_name in ("image", "video"):
            value = getattr(instance, field_name, None)

            if value:
                url = value.url

                if request:
                    data[field_name] = request.build_absolute_uri(url)
                else:
                    data[field_name] = url
            else:
                data[field_name] = ""

        return data


class RentBookingSerializer(serializers.ModelSerializer):
    rent_id = serializers.IntegerField(source="rent.id", read_only=True)
    rent_title = serializers.CharField(source="rent.title", read_only=True)
    rent_location = serializers.CharField(source="rent.location", read_only=True)
    rent_price = serializers.DecimalField(
        source="rent.price",
        max_digits=14,
        decimal_places=2,
        read_only=True,
    )
    rent_price_period = serializers.CharField(
        source="rent.price_period",
        read_only=True,
    )

    customer_id = serializers.IntegerField(
        source="customer.id",
        read_only=True,
    )
    customer_name = serializers.CharField(
        source="customer.username",
        read_only=True,
    )

    owner_id = serializers.IntegerField(
        source="rent.owner.id",
        read_only=True,
    )
    owner_name = serializers.CharField(
        source="rent.owner.username",
        read_only=True,
    )

    rent_image = serializers.SerializerMethodField()
    rent_video = serializers.SerializerMethodField()

    class Meta:
        model = RentBooking
        fields = [
            "id",
            "rent_id",
            "rent_title",
            "rent_location",
            "rent_price",
            "rent_price_period",
            "rent_image",
            "rent_video",
            "customer_id",
            "customer_name",
            "owner_id",
            "owner_name",
            "amount",
            "status",
            "owner_confirmed_at",
            "owner_rejected_at",
            "customer_cancelled_at",
            "completed_at",
            "created_at",
            "updated_at",
        ]
        read_only_fields = fields

    def _media_url(self, obj, field_name):
        value = getattr(obj.rent, field_name)
        if not value:
            return ""

        request = self.context.get("request")
        url = value.url

        if request:
            return request.build_absolute_uri(url)

        return url

    def get_rent_image(self, obj):
        return self._media_url(obj, "image")

    def get_rent_video(self, obj):
        return self._media_url(obj, "video")
